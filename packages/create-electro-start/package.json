{
  "name": "create-electro-start",
  "version": "0.0.1-alpha.0",
  "description": "Scaffold an electro-start desktop app (Electrobun + Vite + React)",
  "type": "module",
  "license": "MIT",
  "author": "mellofordev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mellofordev/electro-start.git",
    "directory": "packages/create-electro-start"
  },
  "homepage": "https://github.com/mellofordev/electro-start/tree/master/packages/create-electro-start#readme",
  "bugs": {
