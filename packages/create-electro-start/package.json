{
  "name": "create-electro-start",
  "version": "0.0.1",
  "description": "Scaffold an electro-start desktop app (Electrobun + Vite + React)",
  "type": "module",
  "bin": {
    "create-electro-start": "./src/index.ts"
  },
  "files": ["src", "templates"],
