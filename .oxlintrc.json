{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-underscore-dangle": ["warn", { "allow": ["__mainFnId"] }]
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/build/**"]
}
