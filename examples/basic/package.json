{
	"name": "electro-start-example",
	"version": "1.0.0",
	"description": "Basic electro-start starter: Expo-style src, shadcn/ui (Base UI + nova), TanStack Router",
	"scripts": {
		"start": "bun --bun vite build && electrobun dev",
		"dev": "bun --bun vite build && electrobun dev --watch",
		"dev:hmr": "bun --bun vite build && concurrently -k \"bun run hmr\" \"electrobun dev\"",
		"hmr": "bun --bun vite --port 5173",
		"build:canary": "bun --bun vite build && electrobun build --env=canary",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@tanstack/react-router": "^1.131.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"electro-start": "workspace:*",
		"electrobun": "1.18.1",
		"lucide-react": "^1.28.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"shadcn": "^4.16.1",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@electro-start/vite-plugin": "workspace:*",
		"@tanstack/router-plugin": "^1.131.0",
		"@types/bun": "latest",
		"@types/node": "^26.1.2",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.0",
		"postcss": "^8.4.49",
		"tailwindcss": "^3.4.16",
		"typescript": "^5.7.2",
		"vite": "6.4.3"
	}
}
